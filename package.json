{
  "name": "hightech-ophase",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "codegen": "graphql-codegen --config codegen.ts",
    "schema:pull": "graphql-codegen --config schema.codegen.ts",
    "schedule:import": "node scripts/import-schedule.mjs"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@vue/apollo-composable": "^4.2.2",
    "graphql": "^16.14.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.3",
    "@graphql-codegen/client-preset": "6.2.0",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@parcel/watcher": "^2.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.7.0",
    "contentful-management": "^12.18.2",
    "csv-parse": "^7.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "ical-generator": "^11.1.1",
    "jiti": "^2.7.0",
    "lottie-web": "^5.13.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.0",
    "vite": "^8.3.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  }
}
